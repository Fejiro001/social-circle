@model SocialCircle.Models.ChatHistoryViewModel

@{
    ViewData["Title"] = "Chat with " + Model.TargetUserName;
}

<div class="sc-chat-box">
    <!-- shows who you are talking to -->
    <div class="sc-chat-header">
        <h4>Chatting with: @Model.TargetUserName</h4>
    </div>

    <!-- Chronological message stream -->
    <div class="sc-chat-stream" id="chatStream">
        @if (!Model.Messages.Any())
        {
            <p class="sc-empty-text text-center mt-4">No past messages. Say hello to start the conversation!</p>
        }


</div>

