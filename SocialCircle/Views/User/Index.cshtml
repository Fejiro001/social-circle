@model SocialCircle.Models.SuggestedUsersViewModel

@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Suggested Users";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">

            <!-- Page Header Card -->
            <div class="card border-0 shadow-sm mb-4 rounded-4 p-4 bg-white">
                <h4 class="fw-bold mb-1">Suggested for You</h4>
                <p class="text-muted mb-0 small">Explore profiles and connect with people in your circle.</p>
            </div>

            <!-- Suggestions List Container -->
            <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
                @if (Model?.SuggestedUsers != null && Model.SuggestedUsers.Any())
                {
                    <div class="list-group list-group-flush">
                        @foreach (var user in Model.SuggestedUsers)
                        {
                            <div class="list-group-item px-4 py-3 d-flex align-items-center justify-content-between border-bottom">
                                <!-- User Info Section -->
                                <div class="d-flex align-items-center gap-3">
                                    <div class="suggested-avatar-box rounded-circle bg-light d-flex align-items-center justify-content-center text-secondary fw-bold" style="width: 48px; height: 48px; overflow: hidden;">
                                        @if (!string.IsNullOrEmpty(user.ProfilePicUrl))
                                        {
                                            <img src="@user.ProfilePicUrl" alt="@user.UserName profile picture" class="w-100 h-100 object-fit-cover" />
                                        }
                                        else
                                        {
                                            <img src="https://api.dicebear.com/8.x/pixel-art/svg?seed=Unknown" alt="Anonymous profile picture" class="w-100 h-100 object-fit-cover" />
                                        }
                                    </div>
                                    <div>
                                        <a asp-controller="User" asp-action="ViewProfile" asp-route-id="@user.UserId" class="text-dark text-decoration-none fw-semibold d-block">
                                            @user.UserName
                                        </a>
                                        <span class="text-muted small">@($"@{user.UserName.ToLower()}")</span>
                                    </div>
                                </div>

                                <!-- Follow Form -->
                                <form asp-controller="User" asp-action="ToggleFollow" method="post" class="m-0">
                                    <input type="hidden" name="targetUserId" value="@user.UserId" />
                                    <button type="submit" class="btn btn-dark btn-sm rounded-pill px-4 fw-medium">
                                        Follow
                                    </button>
                                </form>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-5">
                        <i class="fa-regular fa-face-smile text-muted fs-1 mb-3"></i>
                        <p class="text-muted mb-0">No suggestions available right now. Check back later!</p>
                    </div>
                }
            </div>

        </div>
    </div>
</div>