@model SocialCircle.Models.NewsfeedViewModel

@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Home Feed";
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="error-alert" role="alert">
        @TempData["ErrorMessage"]
    </div>
}

@* Display all active stories *@
@await Component.InvokeAsync("StoryFeed")

<div class="create-post-card">
    <form asp-controller="Post" asp-action="CreatePost" method="post">
        <div class="create-post-form-row">
            <div class="avatar-circle">
                @if (Model.CurrentUser != null && !string.IsNullOrEmpty(Model.CurrentUser.ProfilePicUrl))
                {
                    <img src="@Model.CurrentUser.ProfilePicUrl" alt="@Model.CurrentUser.UserName profile picture" class="img-circle-fit" />
                }
                else
                {
                    <span>@Model.CurrentUser.UserName.Substring(0, 1).ToUpper()</span>
                }
            </div>
            <div class="create-post-textarea-container">
                <textarea name="PostText" class="create-post-textarea" rows="4" placeholder="Share something with your circle..." required></textarea>
            </div>
        </div>
        <div class="create-post-footer">
            <button type="submit" class="btn-primary submit-post-btn">Post</button>
        </div>
    </form>
</div>

<div class="post-container">
    @if (Model.Posts != null && Model.Posts.Any())
    {
        @foreach (var post in Model.Posts)
        {
            <div class="post-box post-card">
                <div class="post-header">
                    <a asp-controller="User" asp-action="ViewProfile" asp-route-id="@post.UserId" class="post-user-info">
                        <div class="post-avatar-box">
                            @if (!string.IsNullOrEmpty(post.ProfilePicUrl))
                            {
                                <img src="@post.ProfilePicUrl" alt="@post.UserName profile picture" class="img-circle-fit" />
                            }
                            else
                            {
                                <span>@post.UserName.Substring(0, 1).ToUpper()</span>
                            }
                        </div>
                        <div>
                            <h6 class="post-username">@($"@{post.UserName}")</h6>
                            <span class="post-timestamp">@post.Timestamp.ToString("MMM dd, yyyy HH:mm tt")</span>
                        </div>
                    </a>
                </div>

                <a asp-controller="Post" asp-action="Details" asp-route-id="@post.PostId" class="post-content">
                    <p class="post-text">@post.PostText</p>
                </a>

                <div class="post-footer-actions">
                    <!-- Like Form -->
                    <form asp-controller="Post" asp-action="ToggleLike" asp-route-postId="@post.PostId" method="post" class="like-form">
                        <button type="submit" class="action-btn @(post.HasCurrentUserLiked ? "liked" : "")">
                            @if (post.HasCurrentUserLiked)
                            {
                                <i class="fa-solid fa-heart text-danger"></i>
                            }
                            else
                            {
                                <i class="fa-regular fa-heart"></i>
                            }
                            <span>@post.LikesCount</span>
                        </button>
                    </form>

                    <!-- Comment Link -->
                    <a asp-controller="Post" asp-action="Details" asp-route-id="@post.PostId" class="action-btn">
                        <i class="fa-regular fa-comment"></i> <span>@post.CommentsCount</span>
                    </a>
                </div>
            </div>
        }
    }
    else
    {
        <div class="empty-feed">
            <p class="empty-feed-title">No posts in your circle yet.</p>
            <p class="empty-feed-subtitle">Be the first to share a thought above!</p>
        </div>
    }
</div>