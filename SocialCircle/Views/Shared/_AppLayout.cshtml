<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SocialCircle</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.0/css/all.min.css" integrity="sha512-ApSLB1Pd3/bZN8fWB/RG9YhN/7bd9Hkf3AGaE2mPfebjrxagjuBtx2GcgdqIlJkUzwylBo61r9Xa9NmgBI0swA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SocialCircle.styles.css" asp-append-version="true" />
</head>
<body class="">
    <header class="mobile-header">
        <div class="header-logo-group">
            <img src="~/images/logo-small.svg" alt="Social Circle logo" class="header-logo-img" />
            <span class="header-title-text">Social Circle</span>
        </div>
        <a asp-controller="Profile" asp-action="Index" class="header-profile-link">
            <div class="header-avatar-circle">
                O
            </div>
        </a>
    </header>

    <div class="dashboard-container">
        <div class="dashboard-row">
            <nav class="desktop-sidebar">
                <div class="sidebar-brand-container">
                    <img src="~/images/logo-small.svg" alt="Social Circle logo" class="sidebar-logo-img" />
                    <a asp-controller="Post" asp-action="Index" class="sidebar-brand-link">Social Circle</a>
                </div>

                <div class="sidebar-nav-list">
                    <a asp-controller="Post" asp-action="Index" class="sidebar-nav-item">
                        <i class="fa-regular fa-house"></i>
                        Home
                    </a>
                    <a asp-controller="Message" asp-action="Index" class="sidebar-nav-item">
                        <i class="fa-regular fa-comment"></i>
                        Messages
                    </a>
                    <a asp-controller="Profile" asp-action="Index" class="sidebar-nav-item">
                        <i class="fa-regular fa-user"></i>
                        Profile
                    </a>
                </div>

                <div class="sidebar-footer-account">
                    <a asp-controller="Profile" asp-action="Index" class="sidebar-account-link">
                        <div class="sidebar-account-avatar">
                            O
                        </div>
                        <div class="sidebar-account-text-group">
                            <span class="sidebar-account-name">My Account</span>
                            <span class="sidebar-account-handle">@("@user")</span>
                        </div>
                    </a>
                </div>
            </nav>

            <main class="main-content-feed" role="main">
                @RenderBody()
            </main>

            <aside class="desktop-aside-widgets">
                @await Component.InvokeAsync("SuggestedUsers")
            </aside>
        </div>
    </div>

    <nav class="mobile-bottom-nav">
        <a asp-controller="Post" asp-action="Index" class="mobile-nav-link">
            <div class="mobile-nav-content">
                <i class="fa-regular fa-house"></i>
                Home
            </div>
        </a>
        <a asp-controller="Message" asp-action="Index" class="mobile-nav-link">
            <div class="mobile-nav-content">
                <i class="fa-regular fa-comment"></i>
                Messages
            </div>
        </a>
        <a asp-controller="Profile" asp-action="Index" class="mobile-nav-link">
            <div class="mobile-nav-content">
                <i class="fa-regular fa-user"></i>
                Profile
            </div>
        </a>
    </nav>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>